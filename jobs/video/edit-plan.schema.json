{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nazonoryutarou-stack.github.io/subeha-portfolio/jobs/video/edit-plan.schema.json",
  "title": "ChatGPT VRM Video Edit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clip", "captions", "layout"],
  "properties": {
    "version": {"const": 1},
    "sourceLabel": {"type": "string"},
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs"],
      "properties": {
        "startMs": {"type": "integer", "minimum": 0},
        "endMs": {"type": "integer", "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hook": {"type": "string"},
        "reason": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "telop": {"type": "string"}
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "endMs", "speaker", "text"],
        "properties": {
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "speaker": {"type": "string", "enum": ["HOST", "GUEST", "UNKNOWN"]},
          "speakerConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "speakerReason": {"type": ["string", "null"]},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "visualReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["startMs", "endMs"],
        "properties": {
          "id": {"type": "string"},
          "assetId": {"type": "string"},
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "url": {"type": ["string", "null"]},
          "dataUrl": {"type": ["string", "null"]},
          "renderFile": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "creator": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]},
          "sourceUrl": {"type": ["string", "null"]}
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string", "enum": ["calm", "normal", "energetic", "deadpan"]},
        "notes": {"type": "string"}
      }
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"const": 720},
            "height": {"const": 1280},
            "captionBottomPx": {"type": "integer", "minimum": 0},
            "background": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"const": 900},
            "height": {"const": 900},
            "captionBottomPx": {"type": "integer", "minimum": 0},
            "background": {"type": ["string", "null"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"const": 1280},
            "height": {"const": 720},
            "captionBottomPx": {"type": "integer", "minimum": 0},
            "background": {"type": ["string", "null"]}
          }
        }
      ]
    }
  }
}
