{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subeha.example/schemas/assistant-edit-plan-v1.json",
  "title": "Subeha Assistant Edit Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceLabel", "clip", "text", "captions"],
  "properties": {
    "version": {"const": 1},
    "sourceLabel": {"type": "string", "minLength": 1},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string"},
        "hook": {"type": "string"},
        "summary": {"type": "string"}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs"],
      "properties": {
        "startMs": {"type": "integer", "minimum": 0},
        "endMs": {"type": "integer", "minimum": 1}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"enum": [720, 900, 1280]},
        "height": {"enum": [720, 900, 1280]},
        "captionBottomPx": {"type": "number", "minimum": 0},
        "background": {"type": ["string", "null"]}
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string"},
        "telop": {"type": "string"}
      }
    },
    "captions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "endMs", "speaker", "text"],
        "properties": {
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "speaker": {"enum": ["HOST", "GUEST", "UNKNOWN"]},
          "text": {"type": "string", "minLength": 1},
          "speakerConfidence": {"type": "number", "minimum": 0, "maximum": 1},
          "speakerReason": {"type": "string"}
        }
      }
    },
    "visualReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["startMs", "endMs", "kind"],
        "properties": {
          "startMs": {"type": "integer", "minimum": 0},
          "endMs": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["search", "generated", "local", "repo"]},
          "query": {"type": ["string", "null"]},
          "prompt": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "dataUrl": {"type": ["string", "null"]},
          "renderFile": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "creator": {"type": ["string", "null"]},
          "license": {"type": ["string", "null"]}
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"enum": ["deadpan", "calm", "normal", "energetic"]},
        "notes": {"type": "string"}
      }
    }
  }
}
